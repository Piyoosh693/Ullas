NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_SECRET=replace-with-a-unique-one-time-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ullas_dev
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=your-verified-sender@gmail.com
BREVO_FROM_NAME=Ullas
PGSSL=disable
# Use 'none' when the frontend and backend are on different domains (e.g. Render static site + web service).
# Use 'lax' only when both are served from the same domain.
COOKIE_SAME_SITE=lax
PUBLIC_APP_URL=http://localhost:5173
